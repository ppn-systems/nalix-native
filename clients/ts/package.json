{
  "name": "@ppn/nalix-sdk",
  "version": "0.1.0",
  "description": "Nalix Native TypeScript / JavaScript Client SDK for Web Browsers and Node.js runtimes",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ppn-systems/nalix-native.git",
    "directory": "clients/ts"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/tests/**/*.test.js",
    "prepack": "npm run build"
  },
  "keywords": [
    "nalix",
    "nalix-sdk",
    "binary-protocol",
    "websocket",
    "browser",
    "networking"
  ],
  "author": "PPN Systems",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/lz4js": "^0.2.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "lz4js": "^0.2.0"
  }
}
